# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- OpenRouter (single provider for chat + embeddings) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Chat model (writes grounded answers)
LLM_MODEL=google/gemma-4-26b-a4b-it:free
# Embedding model (turns chunks/questions into vectors)
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# 0 = discover embedding dimension at runtime from a probe embedding
EMBEDDING_DIM=0

# --- Qdrant ---
# Local dev (backend outside Docker): http://localhost:6333
# Inside docker-compose the backend service overrides this to http://qdrant:6333
# Managed Qdrant Cloud: https://xxxx.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
# Required only for Qdrant Cloud; leave empty for local/self-hosted.
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=claimsage_documents

# --- SQLite registry ---
DATABASE_URL=sqlite:///./claimsage.db

# --- Chunking / retrieval ---
CHUNK_STRATEGY=sentence
CHUNK_SIZE=512
CHUNK_OVERLAP=50
SIMILARITY_TOP_K=6

# --- OCR (scanned PDFs + image uploads) ---
OCR_ENABLED=true
OCR_DEFAULT_MODE=auto
OCR_MIN_CHARS=100
OCR_DPI=300
OCR_LANG=eng

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./storage/uploads

# --- CORS (comma-separated allowed frontend origins) ---
# Add your deployed frontend URL here in production, e.g.:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
